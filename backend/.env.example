# SentinelShield Backend Configuration
ENVIRONMENT=development
DEBUG=True

# SQLite Local Database (Can be swapped with postgresql://user:password@localhost/sentinelshield)
DATABASE_URL=sqlite:///./sentinelshield.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000

# Rate Limiting Configuration
DEFAULT_RATE_LIMIT=120
RATE_LIMIT_WINDOW_SECONDS=60
DEMO_MODE=True

# Proxy Trust Configuration (Comma-separated IPs; DO NOT blindly trust X-Forwarded-For)
TRUSTED_PROXIES=127.0.0.1,::1
